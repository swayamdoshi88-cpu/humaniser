{
  "entities": {
    "User": {
      "title": "User",
      "description": "A user of the Humane AI application",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "User's email address"
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp of account creation"
        }
      },
      "required": ["email", "createdAt"]
    },
    "HumanizeHistory": {
      "title": "HumanizeHistory",
      "description": "A record of humanized text",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string"
        },
        "originalText": {
          "type": "string"
        },
        "finalRewrite": {
          "type": "string"
        },
        "aiPercentageBefore": {
          "type": "number"
        },
        "aiPercentageAfter": {
          "type": "number"
        },
        "createdAt": {
          "type": "string"
        }
      },
      "required": ["userId", "originalText", "finalRewrite", "createdAt"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": {
        "$ref": "#/entities/User"
      },
      "description": "Stores user profiles."
    },
    "users/{userId}/history/{historyId}": {
      "schema": {
        "$ref": "#/entities/HumanizeHistory"
      },
      "description": "Stores text humanization history for a user."
    }
  }
}
